apiVersion: noobaa.io/v1alpha1
kind: NooBaa
metadata:
  name: noobaa
  namespace: {{ odf_project }}
  labels:
    app: noobaa
spec:
  cleanupPolicy:
    allowNoobaaDeletion: true
  defaultBackingStoreSpec:
    type: pv-pool
    pvPool:
      numVolumes: 1
      resources:
        requests:
          storage: 18Gi
  dbResources: {}
  dbType: postgres
  dbVolumeResources:
    requests:
      storage: 2Gi
  endpoints:
    maxCount: 8
    minCount: 8
    resources:
      limits:
        cpu: 1
        memory: 1Gi
      requests:
        cpu: 500m
        memory: 512Mi
  region: storage
  security:
    kms: {}
